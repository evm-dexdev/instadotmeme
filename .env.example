# Instagram credentials
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
IG_USER_ID=your_instagram_numeric_id

# TikTok credentials
TIKTOK_USERNAME=your_tiktok_username
TIKTOK_PASSWORD=your_tiktok_password

# Pump.fun configuration
PUMP_PRIVATE_KEY=your_base58_solana_private_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional configuration
POLL_INTERVAL=60  # How often to check for new mentions (in seconds)

# Server configuration
PORT=3000  # The port the web interface will run on
# Instagram credentials
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
IG_USER_ID=your_instagram_numeric_id
TIKTOK_HEADLESS=true
TIKTOK_SEARCH_TERM=solana nft
MAX_VIDEOS_TO_CHECK=5
CHECK_INBOX_DIRECTLY=true
